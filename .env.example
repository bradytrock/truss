# Optional. Truss already points at the shared project in src/lib/supabase/env.ts.
# Set these only to use a different Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Google Calendar (per-user OAuth). Leave blank to use the Northline demo calendars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {origin}/api/google/calendar/callback
# GOOGLE_REDIRECT_URI=http://localhost:3847/api/google/calendar/callback

# Ask Truss (required for the assistant). Receipt / check scanning also uses this key.
# Without OPENAI_API_KEY, the assistant panel still opens and explains setup;
# Log expense still requires a photo and you type the fields.
OPENAI_API_KEY=
# Optional fallback for receipt / check scanning only. Ask Truss does not use Anthropic.
ANTHROPIC_API_KEY=
