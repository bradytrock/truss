# Optional. Truss already points at the shared project in src/lib/supabase/env.ts.
# Set these only to use a different Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional. Address autofill and the field map geocoder use OpenStreetMap when this is blank.
# Set a Google Maps / Places API key for better US house-number coverage.
# GOOGLE_MAPS_API_KEY=

# Google Calendar (per-user OAuth). Leave blank to use the Northline demo calendars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {origin}/api/google/calendar/callback
# GOOGLE_REDIRECT_URI=http://localhost:3847/api/google/calendar/callback
# Optional. Defaults to {origin}/api/google/gmail/callback
# GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3847/api/google/gmail/callback
# Gmail OAuth needs gmail.readonly and gmail.send. Reconnect after adding send.

# Ask Truss (required for the assistant). Receipt / check scanning also uses this key.
# Without OPENAI_API_KEY, the assistant panel still opens and explains setup;
# Log expense still requires a photo and you type the fields.
OPENAI_API_KEY=
# Optional fallback for receipt / check scanning only. Ask Truss does not use Anthropic.
ANTHROPIC_API_KEY=

# Outbound texts use this office's Photon project under Settings → Photon.
# Each office has its own inbound URL on that page. A shared token is not used.

# LiveKit Cloud (optional). Required for the Photon SIP web dialer under Settings → Calling.
# Create a project at https://cloud.livekit.io and paste the URL / API key / secret.
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Optional public mirror used only for client diagnostics:
# NEXT_PUBLIC_LIVEKIT_URL=https://your-project.livekit.cloud

# Resend (optional). Used when sharing estimates, invoices, and pages by email.
# Verify the domain trockroofer.com in Resend (DNS) before production sends.
RESEND_API_KEY=
# From address is always no-reply@trockroofer.com (required for delivery).
# Display name is "{First name} at {Company}" for the job’s project manager.
# Reply-To is always that PM’s profile email.
# Optional display-name override only (mailbox stays no-reply@…):
# RESEND_FROM_EMAIL=Truss
# Optional global Reply-To fallback (prefer the PM’s profile email):
# RESEND_REPLY_TO=

# EagleView (optional). Company Settings → EagleView can also store credentials per office.
# Without these (and without Settings credentials), orders complete as mock reports with sample squares.
EAGLEVIEW_CLIENT_ID=
EAGLEVIEW_CLIENT_SECRET=
# Optional. Defaults to sandbox (true). Set to false for production EagleView API.
# EAGLEVIEW_SANDBOX=true

# Azure Blob Storage (job files, photos, receipts, logos, company file directory).
# One private container. Object keys stay `{companyId}/{kind}/…`.
# Truss serves files through /api/storage/object — leave anonymous access off.
AZURE_STORAGE_CONTAINER=
# Connection string from the storage account → Access keys.
AZURE_STORAGE_CONNECTION_STRING=
# Instead of a connection string: account name plus a key,
# or account name alone when the host's managed identity can read and write blobs.
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_ACCOUNT_KEY=

# Optional Backblaze B2 fallback while objects are copied.
# When the Azure settings above are set, new uploads go to Azure and reads
# still check this bucket if the key is missing there.
# When the Azure settings are empty, this bucket is still read and written.
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=
# B2_REGION=us-east-005
# B2_ENDPOINT=

# Public origin. Keep this on the live domain so share links, OAuth
# fallbacks, and Stripe returns stay on myroofingtools.com.
# NEXT_PUBLIC_APP_URL=https://myroofingtools.com

# GitHub Actions cron sends Authorization: Bearer $CRON_SECRET.
# Use the same value on App Service and as a GitHub Actions secret.
# CRON_SECRET=

# Stripe (optional host fallback). Companies connect their own keys under
# Settings → Company → Stripe. Host keys are only used if a company has none.
# Webhook URL: https://<your-host>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
