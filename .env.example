# Optional. Truss already points at the shared project in src/lib/supabase/env.ts.
# Set these only to use a different Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Google Calendar (per-user OAuth). Leave blank to use the Northline demo calendars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {origin}/api/google/calendar/callback
# GOOGLE_REDIRECT_URI=http://localhost:3847/api/google/calendar/callback
# Optional. Defaults to {origin}/api/google/gmail/callback
# GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3847/api/google/gmail/callback
# Gmail OAuth needs gmail.readonly and gmail.send. Reconnect after adding send.

# Ask Truss (required for the assistant). Receipt / check scanning also uses this key.
# Without OPENAI_API_KEY, the assistant panel still opens and explains setup;
# Log expense still requires a photo and you type the fields.
OPENAI_API_KEY=
# Optional fallback for receipt / check scanning only. Ask Truss does not use Anthropic.
ANTHROPIC_API_KEY=

# Sendblue (optional). These must live on the Next.js host (Vercel env vars or .env.local).
# Supabase Edge Function Secrets are NOT visible to this app unless you deploy
# supabase/functions/send-text, which reads the same names from Deno.env.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=
# Optional. Required in production so Sendblue’s receive webhook cannot be spoofed.
# Put this same value on the webhook URL: /api/messages/inbound?token=…
MESSAGES_WEBHOOK_TOKEN=
# Optional public origin used when validating share links behind a proxy
# NEXT_PUBLIC_APP_URL=http://localhost:3847
