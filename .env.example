# Optional. Truss already points at the shared project in src/lib/supabase/env.ts.
# Set these only to use a different Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional. Address autofill and the field map geocoder use OpenStreetMap when this is blank.
# Set a Google Maps / Places API key for better US house-number coverage.
# GOOGLE_MAPS_API_KEY=

# Google Calendar (per-user OAuth). Leave blank to use the Northline demo calendars.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {origin}/api/google/calendar/callback
# GOOGLE_REDIRECT_URI=http://localhost:3847/api/google/calendar/callback
# Optional. Defaults to {origin}/api/google/gmail/callback
# GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3847/api/google/gmail/callback
# Gmail OAuth needs gmail.readonly and gmail.send. Reconnect after adding send.

# Ask Truss (required for the assistant). Receipt / check scanning also uses this key.
# Without OPENAI_API_KEY, the assistant panel still opens and explains setup;
# Log expense still requires a photo and you type the fields.
OPENAI_API_KEY=
# Optional fallback for receipt / check scanning only. Ask Truss does not use Anthropic.
ANTHROPIC_API_KEY=

# Photon / Spectrum texts (optional). Spectrum has no HTTP send API, and its
# iMessage client has to stay connected, so outbound does not run inside Vercel.
# Run `npm run photon-worker` on a long-lived Node host with:
#   SPECTRUM_PROJECT_ID=
#   SPECTRUM_PROJECT_SECRET=
#   PHOTON_WORKER_SECRET=
#   PHOTON_FROM_NUMBER=          optional dedicated Business line, E.164
#   PHOTON_WORKER_PORT=8787
# Point this app at that process. Voice agents, automations, and crons text
# through the same worker. They never text homeowners from a missed call.
PHOTON_WORKER_URL=
PHOTON_WORKER_SECRET=
# Signing secret returned once when you register {app origin}/api/messages/inbound
# on the Spectrum project. Required in production so inbound texts cannot be spoofed.
SPECTRUM_WEBHOOK_SECRET=
# Optional extra gate. Photon will not send it unless the webhook URL includes ?token=
MESSAGES_WEBHOOK_TOKEN=

# Resend (optional). Used when sharing estimates, invoices, and pages by email.
# Verify the domain trockroofer.com in Resend (DNS) before production sends.
RESEND_API_KEY=
# From address is always no-reply@trockroofer.com (required for delivery).
# Display name is "{First name} at {Company}" for the job’s project manager.
# Reply-To is always that PM’s profile email.
# Optional display-name override only (mailbox stays no-reply@…):
# RESEND_FROM_EMAIL=Truss
# Optional global Reply-To fallback (prefer the PM’s profile email):
# RESEND_REPLY_TO=

# EagleView (optional). Company Settings → EagleView can also store credentials per office.
# Without these (and without Settings credentials), orders complete as mock reports with sample squares.
EAGLEVIEW_CLIENT_ID=
EAGLEVIEW_CLIENT_SECRET=
# Optional. Defaults to sandbox (true). Set to false for production EagleView API.
# EAGLEVIEW_SANDBOX=true

# Backblaze B2 (required for job files, photos, receipts, and company logos).
# Create a bucket and an application key with read/write on that bucket.
# If the bucket is private (Backblaze requires payment history before public
# buckets), leave B2_PUBLIC_BASE_URL blank — Truss serves files via /api/storage/object.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Region segment from the S3 endpoint, e.g. us-west-004
B2_REGION=us-west-004
# Optional. Defaults to https://s3.{B2_REGION}.backblazeb2.com
# B2_ENDPOINT=
# Optional friendly/CDN base for public URLs (no trailing slash).
# Only works when the B2 bucket is public. Unpaid Backblaze accounts cannot
# enable public buckets — leave this blank and Truss serves files through
# /api/storage/object instead.
# B2_PUBLIC_BASE_URL=

# Optional public origin used when validating share links behind a proxy
# NEXT_PUBLIC_APP_URL=http://localhost:3847

# Stripe (optional host fallback). Companies connect their own keys under
# Settings → Company → Stripe. Host keys are only used if a company has none.
# Webhook URL: https://<your-host>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
